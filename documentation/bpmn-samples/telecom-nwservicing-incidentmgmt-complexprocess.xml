<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="ComplexTelecomProcessDefs"
                  targetNamespace="http://telecom.example.com/complex">

  <bpmn:process id="ComplexTelecomNetworkProvisioning" name="Complex Telecom Network Service Provisioning and Incident Management" isExecutable="true">

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent" name="New Network Service Order Received"/>

    <!-- User Task: Order Entry -->
    <bpmn:userTask id="OrderEntry" name="Capture Service Order"/>

    <!-- Sub-process: Order Validation & Credit Check -->
    <bpmn:subProcess id="OrderValidationSubProcess" name="Order Validation & Credit Check">
      <bpmn:startEvent id="OVStart"/>
      <bpmn:userTask id="VerifyCustomerDetails" name="Verify Customer Details"/>
      <bpmn:userTask id="PerformCreditCheck" name="Perform Credit Check"/>
      <bpmn:endEvent id="OVEnd"/>
      <bpmn:sequenceFlow id="ovf1" sourceRef="OVStart" targetRef="VerifyCustomerDetails"/>
      <bpmn:sequenceFlow id="ovf2" sourceRef="VerifyCustomerDetails" targetRef="PerformCreditCheck"/>
      <bpmn:sequenceFlow id="ovf3" sourceRef="PerformCreditCheck" targetRef="OVEnd"/>
    </bpmn:subProcess>

    <!-- Parallel Gateway: Provisioning and Network Testing start -->
    <bpmn:parallelGateway id="ParallelStartProvision"/>

    <!-- Service Task: Network Provisioning -->
    <bpmn:serviceTask id="NetworkProvisioning" name="Provision Network Services">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="network-provisioning" retries="3"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Service Task: Network Configuration -->
    <bpmn:serviceTask id="NetworkConfiguration" name="Configure Network Elements">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="network-configuration" retries="3"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- Parallel Gateway: Provisioning and Testing converge -->
    <bpmn:parallelGateway id="ParallelEndProvision"/>

    <!-- Script Task: Calculate SLA Response Time (JavaScript) -->
    <bpmn:scriptTask id="CalculateSLAResponse" name="Calculate SLA Response Time" scriptFormat="javascript">
      <bpmn:script>
var priority = execution.getVariable("servicePriority");
var sla = priority === "high" ? 4 : 24; // in hours
execution.setVariable("slaResponseTime", sla);
      </bpmn:script>
    </bpmn:scriptTask>

    <!-- Sub-process: Incident Management -->
    <bpmn:subProcess id="IncidentManagementSubProcess" name="Incident Management">
      <bpmn:startEvent id="IMStart"/>
      <bpmn:userTask id="DetectIncident" name="Detect Network Incident" />
      <bpmn:serviceTask id="DiagnoseIssue" name="Diagnose Issue via Network APIs">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="diagnose-issue" retries="3"/>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="PriorityDecision"/>
      <bpmn:userTask id="AssignEngineer" name="Assign Field Engineer"/>
      <bpmn:callActivity id="FaultManagementCall" name="Fault Management Sub-process" calledElement="FaultManagementSubProcess"/>
      <bpmn:endEvent id="IMEnd"/>
      <bpmn:sequenceFlow id="imf1" sourceRef="IMStart" targetRef="DetectIncident"/>
      <bpmn:sequenceFlow id="imf2" sourceRef="DetectIncident" targetRef="DiagnoseIssue"/>
      <bpmn:sequenceFlow id="imf3" sourceRef="DiagnoseIssue" targetRef="PriorityDecision"/>
      <bpmn:sequenceFlow id="imf4" sourceRef="PriorityDecision" targetRef="AssignEngineer" name="High Priority" />
      <bpmn:sequenceFlow id="imf5" sourceRef="PriorityDecision" targetRef="FaultManagementCall" name="Normal Priority"/>
      <bpmn:sequenceFlow id="imf6" sourceRef="AssignEngineer" targetRef="FaultManagementCall"/>
      <bpmn:sequenceFlow id="imf7" sourceRef="FaultManagementCall" targetRef="IMEnd"/>
    </bpmn:subProcess>

    <!-- Boundary Timer Event on Incident Management for escalation -->
    <bpmn:boundaryEvent id="BoundaryTimerEscalation" attachedToRef="IncidentManagementSubProcess">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- User Task: Escalation Review -->
    <bpmn:userTask id="EscalationReview" name="Escalation Review"/>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent" targetRef="OrderEntry"/>
    <bpmn:sequenceFlow id="flow2" sourceRef="OrderEntry" targetRef="OrderValidationSubProcess"/>
    <bpmn:sequenceFlow id="flow3" sourceRef="OrderValidationSubProcess" targetRef="ParallelStartProvision"/>
    <bpmn:sequenceFlow id="flow4" sourceRef="ParallelStartProvision" targetRef="NetworkProvisioning"/>
    <bpmn:sequenceFlow id="flow5" sourceRef="ParallelStartProvision" targetRef="NetworkConfiguration"/>
    <bpmn:sequenceFlow id="flow6" sourceRef="NetworkProvisioning" targetRef="ParallelEndProvision"/>
    <bpmn:sequenceFlow id="flow7" sourceRef="NetworkConfiguration" targetRef="ParallelEndProvision"/>
    <bpmn:sequenceFlow id="flow8" sourceRef="ParallelEndProvision" targetRef="CalculateSLAResponse"/>
    <bpmn:sequenceFlow id="flow9" sourceRef="CalculateSLAResponse" targetRef="IncidentManagementSubProcess"/>
    <bpmn:sequenceFlow id="flow10" sourceRef="IncidentManagementSubProcess" targetRef="EscalationReview"/>
    <bpmn:sequenceFlow id="flow11" sourceRef="BoundaryTimerEscalation" targetRef="EscalationReview"/>

  </bpmn:process>

  <!-- Fault Management Subprocess -->
  <bpmn:process id="FaultManagementSubProcess" name="Fault Management" isExecutable="true">
    <bpmn:startEvent id="FaultStart"/>
    <bpmn:userTask id="LogFault" name="Log Fault"/>
    <bpmn:serviceTask id="ExecuteRepairService" name="Execute Repair Service">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="repair-service" retries="2"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FaultEnd"/>
    <bpmn:sequenceFlow id="faultFlow1" sourceRef="FaultStart" targetRef="LogFault"/>
    <bpmn:sequenceFlow id="faultFlow2" sourceRef="LogFault" targetRef="ExecuteRepairService"/>
    <bpmn:sequenceFlow id="faultFlow3" sourceRef="ExecuteRepairService" targetRef="FaultEnd"/>
  </bpmn:process>

</bpmn:definitions>
