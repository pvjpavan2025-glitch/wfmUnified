# Production Environment Configuration for wfmApp
# This file will be used when deploying to Azure

# API Gateway URL - using local services
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000

# Process Engine URL - using local services  
NEXT_PUBLIC_PROCESS_ENGINE_URL=http://localhost:8100

# Environment
ENVIRONMENT=production
NODE_ENV=production

# Port for Azure Web Apps
PORT=3000
WEBSITES_PORT=3000
