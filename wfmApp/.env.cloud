# WFM App - Cloud/Azure Environment
# This file is for cloud deployment with Azure Web Apps

# Environment
NODE_ENV=production
ENVIRONMENT=cloud

# Backend Service URLs (Azure Web Apps)
NEXT_PUBLIC_AUTH_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_API_GATEWAY_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_CONFIG_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_RULES_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_SCHEDULER_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_ISSUE_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_DASHBOARD_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
NEXT_PUBLIC_ORDER_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net

# Integration Services (Azure)
NEXT_PUBLIC_INT_SERVICES_URL=https://intservices-webapp.azurewebsites.net

# Process Engine (Azure)
NEXT_PUBLIC_PROCESS_ENGINE_URL=https://wfmprocess-webapp.azurewebsites.net

# Database Configuration (for reference)
MONGO_DB_NAME=wfm
MONGO_COLLECTION_USERS=users
MONGO_COLLECTION_ROLES=roles
MONGO_COLLECTION_TENANTS=tenants

# App Configuration
NEXT_PUBLIC_APP_NAME=WFM Unified
NEXT_PUBLIC_APP_VERSION=1.0.0
