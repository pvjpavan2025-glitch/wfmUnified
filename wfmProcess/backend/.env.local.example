# WFM Process Engine - Local Development Environment
# Copy this to .env.local for local development

# Environment
ENVIRONMENT=local
ENV_FILE=env.local

# Database Configuration - PostgreSQL (Local)
DATABASE_URL=postgresql://wfmprocess:wfmprocess123@localhost:5432/wfmprocess
POSTGRES_USER=wfmprocess
POSTGRES_PASSWORD=wfmprocess123
POSTGRES_DB=wfmprocess
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Service Configuration
APP_NAME=WFM Process Engine
PORT=8090
HOST=0.0.0.0

# Security
JWT_SECRET_KEY=wfmv4-super-secret-jwt-key-change-in-production
SECRET_KEY=wfm-process-engine-secret-key-change-in-production

# WFM Services Integration (Local)
WFM_API_GATEWAY_URL=http://localhost:8000
WFM_AUTH_SERVICE_URL=http://localhost:8001
WFM_CONFIG_SERVICE_URL=http://localhost:8002

# Integration Services
INT_SERVICES_URL=http://localhost:8082

# Workflow Engine Configuration
WORKFLOW_STORAGE_PATH=/app/workflows
WORKFLOW_TEMP_PATH=/tmp/workflows
MAX_WORKFLOW_INSTANCES=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
