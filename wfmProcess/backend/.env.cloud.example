# WFM Process Engine - Cloud/Azure Environment
# Copy this to .env.cloud for cloud deployment

# Environment
ENVIRONMENT=production
ENV_FILE=env.cloud

# Database Configuration - PostgreSQL (Azure)
DATABASE_URL=postgresql://wfmprocess:wfmprocess123@wfmprocess-postgres.postgres.database.azure.com:5432/wfmprocess?sslmode=require
POSTGRES_USER=wfmprocess
POSTGRES_PASSWORD=wfmprocess123
POSTGRES_DB=wfmprocess
POSTGRES_HOST=wfmprocess-postgres.postgres.database.azure.com
POSTGRES_PORT=5432

# Redis Configuration (Azure Redis Cache)
REDIS_URL=redis://default:kIdJfI3xoLxHiKFnCrkGBYffiDla8Y9h@redis-15514.c56.east-us.azure.redns.redis-cloud.com:15514

# Service Configuration
APP_NAME=WFM Process Engine
WEBSITES_PORT=8090
HOST=0.0.0.0

# Security
JWT_SECRET_KEY=wfmv4-super-secret-jwt-key-change-in-production
SECRET_KEY=wfm-process-engine-secret-key-change-in-production

# WFM Services Integration (Azure)
WFM_API_GATEWAY_URL=https://wfmservices-webapp.azurewebsites.net
WFM_AUTH_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net
WFM_CONFIG_SERVICE_URL=https://wfmservices-webapp.azurewebsites.net

# Integration Services
INT_SERVICES_URL=https://intservices-webapp.azurewebsites.net

# Workflow Engine Configuration
WORKFLOW_STORAGE_PATH=/app/workflows
WORKFLOW_TEMP_PATH=/tmp/workflows
MAX_WORKFLOW_INSTANCES=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
