# Next.js Environment Configuration for Online MongoDB
# Copy this file to .env.local and update the values as needed

# Backend Service URLs (Online)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_BPMN_BACKEND_URL=http://localhost:8100
NEXT_PUBLIC_WORKFLOW_INSTANCE_SERVICE_URL=http://localhost:8011/api/v1
NEXT_PUBLIC_WORKFLOW_EXECUTION_SERVICE_URL=http://localhost:8100/api/v1
NODE_ENV=development
# NEXT_PUBLIC_USE_API_PROXY=true
# NEXT_PUBLIC_IMPORT_PROXY_ONLY=true
NEXT_PUBLIC_IMPORT_PROXY_FIRST=true
NEXT_PUBLIC_BPMN_OFFLINE_MODE=true

# -----------------------------
# CORS / Proxy Feature Flags
# -----------------------------
# Master switch: when true, all API route responses will include permissive CORS headers.
CORS_ENABLE_ALL=true
# Comma separated allow-list. Ignored if CORS_ENABLE_ALL=true or CORS_ALLOW_ANY_ORIGIN=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# When true, echo the request Origin instead of '*'. Needed if you later allow credentials.
CORS_DYNAMIC_ORIGIN=true
# When true, use literal '*' for Access-Control-Allow-Origin (cannot be used with credentials)
CORS_ALLOW_ANY_ORIGIN=true
# Allow credentials flag (only works if NOT using wildcard '*'). Leave false for now.
CORS_ALLOW_CREDENTIALS=false
# Additional allowed/exposed headers
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With
CORS_EXPOSE_HEADERS=Content-Length,Content-Type
# Extra methods (base always includes GET,POST,PUT,PATCH,DELETE,OPTIONS)
CORS_EXTRA_METHODS=

# Proxy host restriction override (Option D: allow all domains including non-local)
# When true, the proxy-bpmn route will skip host allow-list security checks.
PROXY_ALLOW_ALL_HOSTS=true
# When false (default), keep original restricted host behavior
PROXY_RESTRICT_HOSTS=false

# MongoDB Online Connection Details
MONGO_USERNAME=wfmadmin
MONGO_PASSWORD=tsarolabs@12345#

# MongoDB Connection String
MONGODB_CONNECTION_STRING=mongodb+srv://wfmadmin:tsarolabs@12345#@wfmdb.cvkb04l.mongodb.net/?retryWrites=true&w=majority&appName=wfmDB

# Python Package Installation Command
# python -m pip install "pymongo[srv]"

# Additional Configuration
MONGO_DB_NAME=wfm
MONGO_COLLECTION_USERS=users
MONGO_COLLECTION_ROLES=roles
MONGO_COLLECTION_TENANTS=tenants
