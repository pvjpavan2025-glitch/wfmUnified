# Environment Configuration for WFM Unified Application

# Frontend Configuration
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_BPMN_BACKEND_URL=http://localhost:8100

# Database Configuration
POSTGRES_DB=workflow
POSTGRES_USER=workflow_user
POSTGRES_PASSWORD=workflow_pass
DATABASE_URL=postgresql+asyncpg://workflow_user:workflow_pass@postgres:5432/workflow

# Redis Configuration
REDIS_URL=redis://redis:6379

# MongoDB Configuration (for production, update with your credentials)
MONGODB_URL=mongodb+srv://wfmadmin:tsarolabs%4012345%23@wfmdb.cvkb04l.mongodb.net/?retryWrites=true&w=majority&appName=wfmDB

# WFM Services Configuration
DATABASE_NAME=wfm
JWT_SECRET_KEY=wfmv4-super-secret-jwt-key-change-in-production
ENVIRONMENT=development
ENV_FILE=env.local

# Message Broker Configuration
MESSAGE_BROKER_TYPE=file  # Options: file, jms

# File-based Configuration
INPUT_DIR=/app/input
OUTPUT_DIR=/app/output

# JMS Configuration (for WebLogic integration)
JMS_URL=t3://weblogic:7001
JMS_USERNAME=weblogic
JMS_PASSWORD=welcome1
JMS_CONNECTION_FACTORY=jms/ConnectionFactory
JMS_REQUEST_QUEUE=jms/OSMRequestQueue
JMS_RESPONSE_QUEUE=jms/OSMResponseQueue

# BPMN Engine Configuration
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
LOG_LEVEL=INFO
