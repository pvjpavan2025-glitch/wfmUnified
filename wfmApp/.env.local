# WFM App - Local Development Environment
# This file is for local development with local backend services

# Environment
NODE_ENV=development
ENVIRONMENT=local

# Backend Service URLs (Local)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_CONFIG_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_RULES_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_SCHEDULER_SERVICE_URL=http://localhost:8004
NEXT_PUBLIC_ISSUE_SERVICE_URL=http://localhost:8005
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:8006
NEXT_PUBLIC_DASHBOARD_SERVICE_URL=http://localhost:8007
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:8008

# Integration Services (Local)
NEXT_PUBLIC_INT_SERVICES_URL=http://localhost:8082

# Process Engine (Local)
NEXT_PUBLIC_PROCESS_ENGINE_URL=http://localhost:8090

# Database Configuration (for reference)
MONGO_DB_NAME=wfm
MONGO_COLLECTION_USERS=users
MONGO_COLLECTION_ROLES=roles
MONGO_COLLECTION_TENANTS=tenants

# App Configuration
NEXT_PUBLIC_APP_NAME=WFM Unified
NEXT_PUBLIC_APP_VERSION=1.0.0
