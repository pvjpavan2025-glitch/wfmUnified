# Application Settings
DEBUG=true
LOG_LEVEL=INFO

# API Settings
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+asyncpg://workflow_user:workflow_pass@localhost:5432/workflow
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# MongoDB
MONGODB_URL=mongodb://wfmadmin:wfmadmin123@localhost:27017/wfm
MONGODB_DATABASE=wfm

# Workflow Engine
MAX_WORKFLOW_INSTANCES=1000
WORKFLOW_TIMEOUT_SECONDS=3600
MAX_TASK_RETRIES=3

# BPMN Processing
MAX_BPMN_FILE_SIZE=10485760
ALLOWED_BPMN_EXTENSIONS=.bpmn,.xml

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
