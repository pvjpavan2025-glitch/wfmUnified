# Production Environment Configuration for wfmApp
# This file will be used when deploying to Azure

# API Gateway URL - will be updated to use API Management
NEXT_PUBLIC_API_GATEWAY_URL=https://wfm-unified-apim.azure-api.net/api/v1

# Process Engine URL - will be updated to use API Management  
NEXT_PUBLIC_PROCESS_ENGINE_URL=https://wfm-unified-apim.azure-api.net/process/v1

# Environment
ENVIRONMENT=production
NODE_ENV=production

# Port for Azure Web Apps
PORT=3000
WEBSITES_PORT=3000
